{
  "show_edit_predictions": false,
  "collaboration_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "minimap": {
    "show": "always"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "cursor_shape": "bar"
  },
  "sticky_scroll": {
    "enabled": false
  },
  "cursor_blink": true,
  "buffer_font_fallbacks": ["Consolas", "Courier New", "monospace"],
  "buffer_font_family": "Cascadia Code PL",
  "linked_edits": true,
  "soft_wrap": "editor_width",
  "icon_theme": "Symbols Icon Theme",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Espresso (Blur) [Heavy]"
  }
}
