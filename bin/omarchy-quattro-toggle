#!/bin/bash

set -euo pipefail

export OMARCHY_PATH="$HOME/.config/omarchy/quattro-bar-only"

case "${1:-}" in
  idle-lock) "$HOME/.config/hypr/scripts/osd.sh" idle-toggle ;;
  notifications) swaync-client -d -sw ;;
  screensaver) "$HOME/.config/hypr/scripts/osd.sh" screensaver-toggle ;;
  nightlight) "$HOME/.config/hypr/scripts/osd.sh" nightlight-toggle ;;
  top-bar) omarchy-toggle-bar ;;
  workspace-layout) omarchy-hyprland-workspace-layout-toggle ;;
  window-gaps) omarchy-hyprland-window-gaps-toggle ;;
  one-window-ratio) omarchy-hyprland-window-single-square-aspect-toggle ;;
  *)
    echo "Usage: omarchy-quattro-toggle {idle-lock|notifications|screensaver|nightlight|top-bar|workspace-layout|window-gaps|one-window-ratio}" >&2
    exit 2
    ;;
esac
