#!/bin/bash

set -euo pipefail

export OMARCHY_PATH="$HOME/.config/omarchy/quattro-bar-only"

options=$("$HOME/.local/share/omarchy/bin/omarchy-menu-keybindings" --print |
  jq -Rsc 'split("\n") | map(select(length > 0))')
payload=$(jq -nc --argjson options "$options" \
  '{mode:"select",prompt:"Keybindings",width:800,maxHeight:400,options:$options}')

omarchy-shell shell toggle omarchy.menu "$payload"
