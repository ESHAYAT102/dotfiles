#!/usr/bin/env bash
# Monitors MPRIS playback via raw D-Bus and inhibits Omarchy's idle while
# media is actually playing (position advancing). Re-enables idle when paused/stopped.
# Handles Zen/Firefox bug where PlaybackStatus stays "Playing" even when paused
# by comparing position over time.

STATE_FILE="/tmp/omarchy-idle-inhibit-on-media"

get_positions() {
  local bus_names
  bus_names=$(busctl --user list 2>/dev/null | grep "org.mpris.MediaPlayer2\." | grep -v playerctld | awk '{print $1}') || true

  for name in $bus_names; do
    dbus-send --session --dest="$name" --type=method_call --print-reply \
      /org/mpris/MediaPlayer2 org.freedesktop.DBus.Properties.Get \
      string:"org.mpris.MediaPlayer2.Player" string:"Position" 2>/dev/null \
      | grep "int64" | awk '{print $NF}'
  done
}

is_actively_playing() {
  local pos1 pos2
  pos1=$(get_positions)
  sleep 2
  pos2=$(get_positions)

  if [ -z "$pos1" ] || [ -z "$pos2" ]; then
    return 1
  fi

  # If ANY position changed, media is actually playing
  while IFS= read -r p1; do
    while IFS= read -r p2; do
      if [ "$p1" != "$p2" ]; then
        return 0
      fi
    done <<< "$pos2"
  done <<< "$pos1"

  return 1
}

disable_idle() {
  [ -f "$STATE_FILE" ] && return
  omarchy-shell idle disable >/dev/null 2>&1 || true
  touch "$STATE_FILE"
}

enable_idle() {
  [ -f "$STATE_FILE" ] || return
  omarchy-shell idle enable >/dev/null 2>&1 || true
  rm -f "$STATE_FILE"
}

cleanup() { enable_idle; }
trap cleanup EXIT

while true; do
  if is_actively_playing; then
    disable_idle
  else
    enable_idle
  fi
  sleep 1
done
