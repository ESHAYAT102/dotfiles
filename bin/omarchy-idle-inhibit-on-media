#!/usr/bin/env bash
# Monitors MPRIS playback state via raw D-Bus and toggles Omarchy's idle
# system by directly manipulating the stay-awake state file.
# Bypasses omarchy-shell IPC to avoid potential race conditions.

STATE_FILE="/tmp/omarchy-idle-inhibit-on-media"
STAY_AWAKE_DIR="$HOME/.local/state/omarchy/indicators"
STAY_AWAKE_FILE="$STAY_AWAKE_DIR/stay-awake"

is_any_playing() {
  local bus_names
  bus_names=$(busctl --user list 2>/dev/null | grep "org.mpris.MediaPlayer2\." | grep -v playerctld | awk '{print $1}') || true

  for name in $bus_names; do
    if dbus-send --session --dest="$name" --type=method_call --print-reply \
      /org/mpris/MediaPlayer2 org.freedesktop.DBus.Properties.Get \
      string:"org.mpris.MediaPlayer2.Player" string:"PlaybackStatus" 2>/dev/null \
      | grep -qi 'Playing'; then
      return 0
    fi
  done
  return 1
}

disable_idle() {
  if [ ! -f "$STATE_FILE" ]; then
    mkdir -p "$STAY_AWAKE_DIR"
    touch "$STAY_AWAKE_FILE"
    touch "$STATE_FILE"
  fi
}

enable_idle() {
  if [ -f "$STATE_FILE" ]; then
    rm -f "$STAY_AWAKE_FILE"
    rm -f "$STATE_FILE"
  fi
}

cleanup() {
  enable_idle
}
trap cleanup EXIT

# Main loop: check every 2 seconds
while true; do
  if is_any_playing; then
    disable_idle
  else
    enable_idle
  fi
  sleep 2
done
