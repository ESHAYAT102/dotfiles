#!/usr/bin/env bash
# Monitors MPRIS playback state via raw D-Bus and inhibits Omarchy's idle
# system while any player is active. Re-enables idle when all players pause/stop.
# Mirrors the "inhibitWhenAudio" approach used by Caelestia shell.
# Uses raw D-Bus instead of playerctl to handle Zen/Firefox dynamic names.

set -euo pipefail

STATE_FILE="/tmp/omarchy-idle-inhibit-on-media"
IDLE_CMD="omarchy-shell idle"

is_any_playing() {
  local bus_names
  bus_names=$(busctl --user list 2>/dev/null | grep "org.mpris.MediaPlayer2\." | grep -v playerctld | awk '{print $1}' || true)

  for name in $bus_names; do
    if dbus-send --session --dest="$name" --type=method_call --print-reply \
      /org/mpris/MediaPlayer2 org.freedesktop.DBus.Properties.Get \
      string:"org.mpris.MediaPlayer2.Player" string:"PlaybackStatus" 2>/dev/null \
      | grep -qi 'Playing'; then
      return 0
    fi
  done
  return 1
}

disable_idle() {
  [[ -f "$STATE_FILE" ]] && return
  $IDLE_CMD disable >/dev/null 2>&1
  touch "$STATE_FILE"
}

enable_idle() {
  [[ -f "$STATE_FILE" ]] || return
  $IDLE_CMD enable >/dev/null 2>&1
  rm -f "$STATE_FILE"
}

# Cleanup on exit
trap 'enable_idle; rm -f "$STATE_FILE"' EXIT

# Main loop: check every 2 seconds
while true; do
  if is_any_playing; then
    disable_idle
  else
    enable_idle
  fi
  sleep 2
done
