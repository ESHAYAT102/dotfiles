[Unit]
Description=Omarchy Quickshell desktop shell
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=OMARCHY_PATH=/usr/share/omarchy
ExecStart=/usr/bin/quickshell -n -p /usr/share/omarchy/shell
ExecStartPost=/usr/bin/bash -c 'sleep 2; %h/.local/bin/omarchy-quattro-plymouth-switcher --preload'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
