[Unit]
Description=T3 Code server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=T3CODE_HOME=/home/esh/.t3
Environment=T3_BOOT_SERVICE_UNIT=t3code.service
ExecStart=/home/linuxbrew/.linuxbrew/Cellar/node/26.5.1/bin/node /home/esh/.t3/runtime/service-launcher.mjs
KillMode=control-group
Restart=always
RestartSec=5
StandardOutput=append:/home/esh/.t3/userdata/logs/boot-service.log
StandardError=append:/home/esh/.t3/userdata/logs/boot-service.log

[Install]
WantedBy=default.target
