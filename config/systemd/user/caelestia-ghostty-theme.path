[Unit]
Description=Watch Caelestia palette changes for Ghostty, Yazi, and Zen

[Path]
PathChanged=%h/.local/state/caelestia/scheme.json
# A fresh Zen install creates its generated profile only on first launch. Run
# the generator again at that point so userChrome.css is installed even when
# Zen had no profile during the initial dotfiles setup.
PathChanged=%h/.config/zen/profiles.ini
Unit=caelestia-ghostty-theme.service

[Install]
WantedBy=default.target
