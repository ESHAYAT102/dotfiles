{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   keywords    Extra search terms beyond id/label/aliases.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal","keywords":"notes projects"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes","keywords":"notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents","keywords":"files documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"omarchy-launch-browser 'https://learn.omacom.io/2/the-omarchy-manual/53/hotkeys'"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"omarchy-launch-browser 'https://learn.omacom.io/2/the-omarchy-manual'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"omarchy-launch-browser 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"omarchy-launch-browser 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"omarchy-launch-browser 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"omarchy-launch-browser 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"omarchy-launch-browser 'https://learn.omacom.io/2/the-omarchy-manual/106/terminal'"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"env OMARCHY_PATH=$HOME/.config/omarchy/quattro-bar-only omarchy-shell shell toggle omarchy.reminders"},
  "trigger.toggle.idle-lock": {"action":"omarchy-quattro-toggle idle-lock"},
  "trigger.toggle.notifications": {"action":"omarchy-quattro-toggle notifications"},
  "trigger.toggle.screensaver": {"action":"omarchy-quattro-toggle screensaver"},
  "trigger.toggle.nightlight": {"action":"omarchy-quattro-toggle nightlight"},
  "trigger.toggle.top-bar": {"action":"omarchy-quattro-toggle top-bar"},
  "trigger.toggle.workspace-layout": {"action":"omarchy-quattro-toggle workspace-layout"},
  "trigger.toggle.window-gaps": {"action":"omarchy-quattro-toggle window-gaps"},
  "trigger.toggle.one-window-ratio": {"action":"omarchy-quattro-toggle one-window-ratio"},
  "style.theme": {"action":"omarchy-quattro-selector theme"},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"omarchy-quattro-selector unlock"},
  "style.background": {"action":"omarchy-quattro-selector background"},
}
