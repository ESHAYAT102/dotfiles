          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.spacer",
          "size": 8
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "left": [
        {
          "id": "esh.menu"
        },
        {
          "id": "esh.workspaces"
        }
      ],
