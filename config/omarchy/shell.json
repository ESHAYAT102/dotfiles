{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "lock": {
    "blank": false
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "esh.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "io.github.sumdahl.media"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "esh.clock",
          "format": "hh:mm:ss A",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "gennaro.updater"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "esh.ajazz-keyboard"
        },
        {
          "id": "io.github.fernandomenolli.sill"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "esh.hide-icons",
          "items": [
            "esh.ajazz-keyboard",
            "io.github.fernandomenolli.sill",
            "omarchy.agents",
            "omarchy.tailscale"
          ]
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "b.omanote"
        },
        {
          "id": "esh.notification-center"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "esh.lock"
    },
    {
      "id": "esh.osd"
    },
    {
      "id": "esh.media-idle"
    },
    {
      "id": "esh.confetti"
    }
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.osd"
  ],
  "cloneSourceRestores": [
    "esh.lock",
    "esh.osd"
  ]
}
