#!/usr/bin/env bash
# Set up esh.notification-center as the notification daemon.
# Disables omarchy.notifications so only one daemon owns the bus.
#
# Usage: bash bin/install

set -euo pipefail

SHELL_JSON="${HOME}/.config/omarchy/shell.json"

if [[ ! -f "$SHELL_JSON" ]]; then
  echo "Error: $SHELL_JSON not found" >&2
  exit 1
fi

echo "Updating shell.json..."

tmp=$(mktemp)
cp "$SHELL_JSON" "$tmp"

# Ensure esh.notification-center is in plugins
if ! jq -e '.plugins[]? | select(.id == "esh.notification-center")' "$tmp" >/dev/null 2>&1; then
  jq '.plugins += [{"id": "esh.notification-center"}]' "$tmp" > "$tmp.new" && mv "$tmp.new" "$tmp"
fi

# Ensure esh.notification-center is in the bar layout
if ! jq -e '.bar.layout.right[]? | select(.id == "esh.notification-center")' "$tmp" >/dev/null 2>&1; then
  jq '.bar.layout.right += [{"id": "esh.notification-center"}]' "$tmp" > "$tmp.new" && mv "$tmp.new" "$tmp"
fi

# Disable omarchy.notifications so it doesn't fight over the bus
if ! jq -e '.disabledPlugins[]? | select(. == "omarchy.notifications")' "$tmp" >/dev/null 2>&1; then
  jq '.disabledPlugins += ["omarchy.notifications"]' "$tmp" > "$tmp.new" && mv "$tmp.new" "$tmp"
fi

mv "$tmp" "$SHELL_JSON"
echo "shell.json updated."

echo "Restarting shell..."
omarchy restart shell

echo "Done. esh.notification-center is the notification daemon."
