# dynamic theme colors
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

window-decoration = none

# Font
font-family = "FiraCode Nerd Font"
font-size = 9
font-style = Bold
font-style-bold = ExtraBold
font-style-italic = Italic
font-feature = +liga, +dlig, +calt

# Looks
theme = Catppuccin Mocha
background-opacity = 0.9
background-blur = true

# Window
window-padding-x = 16
window-padding-y = 16
confirm-close-surface=false
resize-overlay = never

# Cursor stlying
cursor-style = "bar"
cursor-style-blink = false
shell-integration-features = no-cursor

unfocused-split-opacity = 0.55

# keyboard bindings
keybind = f11=toggle_fullscreen
keybind = ctrl+w=close_tab
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+l=clear_screen
keybind = ctrl+equal=equalize_splits
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+shift+up=new_split:up
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+shift+left=new_split:left
keybind = ctrl+shift+right=new_split:right

