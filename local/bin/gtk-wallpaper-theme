#!/usr/bin/env bash

set -euo pipefail

mode="${1:-}"
mode_file="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-shell-mode"
if [[ -z "$mode" ]]; then
  [[ -r "$mode_file" ]] && mode="$(<"$mode_file")" || mode=caelestia
fi

case "$mode" in
  caelestia)
    scheme="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/scheme.json"
    [[ -r "$scheme" ]] || exit 0
    colour() { jq -er --arg key "$1" '"#" + .colours[$key]' "$scheme"; }
    background=$(colour background)
    surface=$(colour surfaceContainerLow)
    surface_high=$(colour surfaceContainer)
    foreground=$(colour onSurface)
    accent=$(colour primary)
    accent_foreground=$(colour onPrimary)
    selection=$(colour primaryContainer)
    selection_foreground=$(colour onPrimaryContainer)
    border=$(colour outlineVariant)
    ;;
  omarchy)
    state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
    background_path=$(readlink -f "$state/background" 2>/dev/null || true)
    [[ -f "$background_path" ]] || exit 0
    scheme=$(caelestia wallpaper -p "$background_path")
    colour() { jq -er --arg key "$1" '"#" + .colours[$key]' <<<"$scheme"; }
    background=$(colour background)
    surface=$(colour surfaceContainerLow)
    surface_high=$(colour surfaceContainer)
    foreground=$(colour onSurface)
    accent=$(colour primary)
    accent_foreground=$(colour onPrimary)
    selection=$(colour primaryContainer)
    selection_foreground=$(colour onPrimaryContainer)
    border=$(colour outlineVariant)
    ;;
  *) exit 2 ;;
esac

for value in "$background" "$surface" "$surface_high" "$foreground" "$accent" "$accent_foreground" "$selection" "$selection_foreground" "$border"; do
  [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] || exit 1
done

for version in 3.0 4.0; do
  output="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$version/gtk.css"
  mkdir -p "$(dirname "$output")"
  temporary=$(mktemp "${output}.XXXXXX")
  cat > "$temporary" <<EOF
/* Generated from the active $mode wallpaper palette; do not edit. */
@define-color accent_color $accent;
@define-color accent_fg_color $accent_foreground;
@define-color accent_bg_color $accent;
@define-color window_bg_color $background;
@define-color window_fg_color $foreground;
@define-color headerbar_bg_color $background;
@define-color headerbar_fg_color $foreground;
@define-color popover_bg_color $surface;
@define-color popover_fg_color $foreground;
@define-color view_bg_color $background;
@define-color view_fg_color $foreground;
@define-color card_bg_color $surface;
@define-color card_fg_color $foreground;
@define-color sidebar_bg_color $background;
@define-color sidebar_fg_color $foreground;
@define-color sidebar_border_color $border;
@define-color sidebar_backdrop_color $background;
@define-color theme_selected_bg_color $selection;
@define-color theme_selected_fg_color $selection_foreground;
@define-color wallpaper_surface_color $surface;
@define-color wallpaper_surface_high_color $surface_high;

@import "thunar.css";
EOF
  chmod 600 "$temporary"
  mv -f "$temporary" "$output"
done

gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'

# Libadwaita reads user GTK CSS at process startup.
if pgrep -x nautilus >/dev/null; then
  nautilus -q >/dev/null 2>&1 || true
  setsid uwsm-app -- nautilus >/dev/null 2>&1 &
fi
