#!/bin/bash
set -u

# HyprPM only needs privilege while building/updating plugins. Loading an
# already-enabled plugin into the running compositor must stay user-level.
instance_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-unknown}"
marker="$instance_dir/.hyprpm-loaded"

[[ -e "$marker" ]] && exit 0
mkdir -p "$instance_dir"
touch "$marker"

# Let Hyprland finish opening its IPC sockets before asking HyprPM to load.
sleep 1
if hyprpm reload -nn; then
  # The first parse happens before plugins exist, so parse once more after the
  # plugin is loaded to register its settings and dispatchers without errors.
  sleep 1
  hyprctl reload
else
  rm -f "$marker"
  notify-send -u critical "Hyprland plugins" "HyprPM could not load enabled plugins"
  exit 1
fi

