#!/usr/bin/env bash

set -euo pipefail
export PATH="$HOME/.bun/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"

output=$(hyprctl monitors -j | jq -er '.[] | select(.focused) | .name')
screenshot_dir=/tmp/opencode-screenshots
mkdir -p "$screenshot_dir"
screenshot="$screenshot_dir/$(date +%Y_%d_%-m_%I_%M_%p).png"
window_title="OpenCode Screenshot $$"

grim -o "$output" "$screenshot"

ghostty --title="$window_title" \
  --keybind="ctrl+alt+v=text:\\x1b[200~${screenshot}\\x1b[201~" \
  -e opencode &
ghostty_pid=$!

(
  for _ in $(seq 1 200); do
    address=$(hyprctl clients -j | jq -r --arg title "$window_title" 'first(.[] | select(.initialTitle == $title) | .address) // ""')
    if [[ -n "$address" ]]; then
      sleep 5
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null
      sleep 0.2
      wtype -M ctrl -M alt -k v -m alt -m ctrl
      wtype -M shift -k Return -m shift
      exit 0
    fi
    sleep 0.05
  done
) &

wait "$ghostty_pid"
