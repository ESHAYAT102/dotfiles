#!/usr/bin/env bash

set -euo pipefail

scheme="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/scheme.json"
output="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/caelestia-colors.conf"
yazi_template="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/theme.template.toml"
yazi_output="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/theme.toml"
zen_root="${XDG_CONFIG_HOME:-$HOME/.config}/zen"

[[ -r "$scheme" ]] || exit 0

required=(
  base mantle crust text subtext1 subtext0 overlay2 overlay1 overlay0
  surface2 surface1 surface0 rosewater flamingo pink mauve red maroon peach
  yellow green teal sky sapphire blue lavender primary onPrimary
  primaryContainer onPrimaryContainer outlineVariant
)
for colour in "${required[@]}" term{0..15}; do
  value="$(jq -er --arg colour "$colour" '.colours[$colour] | select(test("^[0-9A-Fa-f]{6}$"))' "$scheme")" || exit 1
  printf -v "$colour" '%s' "$value"
done

mkdir -p "$(dirname "$output")"
temporary="$(mktemp "${output}.XXXXXX")"
trap 'rm -f "$temporary"' EXIT

{
  printf '# Generated from Caelestia scheme.json; do not edit.\n'
  for index in {0..15}; do
    colour="term${index}"
    printf 'palette = %s=#%s\n' "$index" "${!colour}"
  done
  printf 'background = #%s\n' "$base"
  printf 'foreground = #%s\n' "$text"
  printf 'cursor-color = #%s\n' "$primary"
  printf 'cursor-text = #%s\n' "$onPrimary"
  printf 'selection-background = #%s\n' "$primaryContainer"
  printf 'selection-foreground = #%s\n' "$onPrimaryContainer"
  printf 'split-divider-color = #%s\n' "$outlineVariant"
} > "$temporary"

chmod 600 "$temporary"
mv -f "$temporary" "$output"
trap - EXIT

# Ghostty reloads its configuration on SIGUSR2.
pkill -SIGUSR2 -x ghostty 2>/dev/null || true

# Yazi's theme contains extensive file/icon rules. Keep those rules in a
# template and translate only the Catppuccin palette into Caelestia's current
# wallpaper-derived palette.
if [[ -r "$yazi_template" ]]; then
  yazi_temporary="$(mktemp "${yazi_output}.XXXXXX")"
  sed \
    -e "s/#1e1e2e/#${base}/g" \
    -e "s/#181825/#${mantle}/g" \
    -e "s/#11111b/#${crust}/g" \
    -e "s/#cdd6f4/#${text}/g" \
    -e "s/#bac2de/#${subtext1}/g" \
    -e "s/#a6adc8/#${subtext0}/g" \
    -e "s/#9399b2/#${overlay2}/g" \
    -e "s/#7f849c/#${overlay1}/g" \
    -e "s/#6c7086/#${overlay0}/g" \
    -e "s/#585b70/#${surface2}/g" \
    -e "s/#45475a/#${surface1}/g" \
    -e "s/#313244/#${surface0}/g" \
    -e "s/#f5e0dc/#${rosewater}/g" \
    -e "s/#f2cdcd/#${flamingo}/g" \
    -e "s/#f5c2e7/#${pink}/g" \
    -e "s/#cba6f7/#${mauve}/g" \
    -e "s/#f38ba8/#${red}/g" \
    -e "s/#eba0ac/#${maroon}/g" \
    -e "s/#fab387/#${peach}/g" \
    -e "s/#f9e2af/#${yellow}/g" \
    -e "s/#a6e3a1/#${green}/g" \
    -e "s/#94e2d5/#${teal}/g" \
    -e "s/#89dceb/#${sky}/g" \
    -e "s/#74c7ec/#${sapphire}/g" \
    -e "s/#89b4fa/#${blue}/g" \
    -e "s/#b4befe/#${lavender}/g" \
    "$yazi_template" > "$yazi_temporary"
  chmod 600 "$yazi_temporary"
  mv -f "$yazi_temporary" "$yazi_output"
fi

# Zen exposes its browser chrome through Firefox's userChrome stylesheet. Find
# the active release profile rather than relying on its generated directory
# name, then keep a small imported palette file in sync with Caelestia.
zen_profile=""
if [[ -r "$zen_root/profiles.ini" ]]; then
  zen_profile_rel="$(awk '
    /^\[Install/ { in_install = 1; next }
    /^\[/ { in_install = 0 }
    in_install && /^Default=/ { sub(/^Default=/, ""); print; exit }
  ' "$zen_root/profiles.ini")"
  if [[ -n "$zen_profile_rel" && -d "$zen_root/$zen_profile_rel" ]]; then
    zen_profile="$zen_root/$zen_profile_rel"
  fi
fi

if [[ -n "$zen_profile" ]]; then
  zen_chrome="$zen_profile/chrome"
  zen_palette="$zen_chrome/zen-caelestia-colors.css"
  zen_user_chrome="$zen_chrome/userChrome.css"
  zen_user_js="$zen_profile/user.js"
  mkdir -p "$zen_chrome"

  zen_temporary="$(mktemp "${zen_palette}.XXXXXX")"
  {
    printf '/* Generated from Caelestia scheme.json; do not edit. */\n'
    printf ':root {\n'
    printf '  --zen-primary-color: #%s !important;\n' "$primary"
    printf '  --zen-colors-primary: #%s !important;\n' "$surface1"
    printf '  --zen-colors-secondary: #%s !important;\n' "$surface0"
    printf '  --zen-colors-tertiary: #%s !important;\n' "$mantle"
    printf '  --zen-colors-border: #%s !important;\n' "$outlineVariant"
    printf '  --zen-main-browser-background: #%s !important;\n' "$base"
    printf '  --toolbar-bgcolor: #%s !important;\n' "$surface0"
    printf '  --toolbar-color: #%s !important;\n' "$text"
    printf '  --toolbar-field-background-color: #%s !important;\n' "$surface1"
    printf '  --toolbar-field-focus-background-color: #%s !important;\n' "$surface2"
    printf '  --toolbar-field-color: #%s !important;\n' "$text"
    printf '  --toolbar-field-focus-color: #%s !important;\n' "$text"
    printf '  --lwt-accent-color: #%s !important;\n' "$base"
    printf '  --lwt-text-color: #%s !important;\n' "$text"
    printf '  --lwt-toolbar-field-highlight: #%s !important;\n' "$primaryContainer"
    printf '  --lwt-toolbar-field-highlight-text: #%s !important;\n' "$onPrimaryContainer"
    printf '}\n'
    printf 'menupopup > menuitem[_moz-menuactive],\n'
    printf 'menupopup > menu[_moz-menuactive] {\n'
    printf '  background-color: #%s !important;\n' "$primaryContainer"
    printf '  color: #%s !important;\n' "$onPrimaryContainer"
    printf '}\n'
    printf '#context-navigation {\n'
    printf '  --button-hover-bgcolor: #%s !important;\n' "$primaryContainer"
    printf '  --toolbarbutton-hover-background: #%s !important;\n' "$primaryContainer"
    printf '}\n'
    printf '#context-navigation > .menuitem-iconic:hover,\n'
    printf '#context-navigation > toolbarbutton:hover,\n'
    printf '#context-navigation > .menuitem-iconic[_moz-menuactive="true"],\n'
    printf '#context-navigation > toolbarbutton[_moz-menuactive="true"] {\n'
    printf '  background: #%s !important;\n' "$primaryContainer"
    printf '  color: #%s !important;\n' "$onPrimaryContainer"
    printf '  fill: currentColor !important;\n'
    printf '}\n'
    printf '#historyTree treechildren::-moz-tree-row(hover) {\n'
    printf '  background-color: color-mix(in srgb, #%s 55%%, transparent) !important;\n' "$primaryContainer"
    printf '  border-color: transparent !important;\n'
    printf '}\n'
    printf '#historyTree treechildren::-moz-tree-row(selected) {\n'
    printf '  background-color: #%s !important;\n' "$primaryContainer"
    printf '  border-color: transparent !important;\n'
    printf '  outline: none !important;\n'
    printf '}\n'
    printf '#historyTree treechildren::-moz-tree-row(selected, focus) {\n'
    printf '  background-color: #%s !important;\n' "$primaryContainer"
    printf '  border-color: #%s !important;\n' "$primary"
    printf '  outline: none !important;\n'
    printf '}\n'
    printf '#historyTree treechildren::-moz-tree-row(current),\n'
    printf '#historyTree treechildren::-moz-tree-row(current, focus) {\n'
    printf '  background-color: #%s !important;\n' "$primary"
    printf '  border-color: #%s !important;\n' "$primary"
    printf '  outline: none !important;\n'
    printf '}\n'
    printf '#historyTree treechildren::-moz-tree-cell-text(selected) {\n'
    printf '  color: #%s !important;\n' "$onPrimaryContainer"
    printf '}\n'
    printf '#historyTree treechildren::-moz-tree-cell-text(current),\n'
    printf '#historyTree treechildren::-moz-tree-cell-text(current, focus) {\n'
    printf '  color: #%s !important;\n' "$onPrimary"
    printf '}\n'
    printf '#historyTree,\n'
    printf '#historyTree:focus,\n'
    printf '#historyTree:focus-visible {\n'
    printf '  outline: none !important;\n'
    printf '}\n'
  } > "$zen_temporary"
  chmod 600 "$zen_temporary"
  mv -f "$zen_temporary" "$zen_palette"

  if [[ ! -e "$zen_user_chrome" ]]; then
    printf '@import url("zen-mode-colors.css");\n' > "$zen_user_chrome"
  elif ! grep -Fqx '@import url("zen-mode-colors.css");' "$zen_user_chrome"; then
    zen_chrome_temporary="$(mktemp "${zen_user_chrome}.XXXXXX")"
    {
      printf '@import url("zen-mode-colors.css");\n'
      grep -Fvx '@import url("caelestia-colors.css");' "$zen_user_chrome" || true
    } > "$zen_chrome_temporary"
    chmod --reference="$zen_user_chrome" "$zen_chrome_temporary"
    mv -f "$zen_chrome_temporary" "$zen_user_chrome"
  fi

  if [[ ! -e "$zen_user_js" ]] || ! grep -Fq 'toolkit.legacyUserProfileCustomizations.stylesheets' "$zen_user_js"; then
    printf 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n' >> "$zen_user_js"
  fi
fi
