#!/usr/bin/env bash

set -euo pipefail

mode_file="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-shell-mode"
if [[ -r "$mode_file" ]]; then
  mode="$(<"$mode_file")"
else
  mode="caelestia"
fi
action="${1:-}"

if [[ "$mode" == "caelestia" ]]; then
  if [[ "$action" == "lock" ]] && pgrep -f '[o]rg\.omarchy\.screensaver' >/dev/null; then
    exit 0
  fi

  case "$action" in
    notifications) exec caelestia shell drawers toggle sidebar ;;
    dashboard)     exec caelestia shell drawers toggle dashboard ;;
    clear-notifications) exec caelestia shell notifs clear ;;
    dnd)           exec caelestia shell notifs toggleDnd ;;
    wifi)          exec caelestia shell barPopouts toggle network ;;
    bluetooth)     exec caelestia shell barPopouts toggle bluetooth ;;
    audio)         exec caelestia shell barPopouts toggle audio ;;
    monitor)       exec caelestia shell drawers toggle dashboard ;;
    battery)       exec caelestia shell barPopouts toggle battery ;;
    weather)       exec caelestia shell drawers toggle dashboard ;;
    clipboard)     exec caelestia shell launcher toggle ">clipboard " ;;
    wallpaper)     exec caelestia shell launcher toggle ">wallpaper " ;;
    apps)          exec caelestia shell launcher toggle "" ;;
    power)         exec caelestia shell drawers toggle session ;;
    taskbar)       exec caelestia shell barState toggle ;;
    settings)      exec caelestia shell nexus open ;;
    keybinds)      exec caelestia shell launcher toggle ">keybinds " ;;
    emoji)         exec caelestia shell launcher toggle ">emoji " ;;
    capture)       exec caelestia shell launcher toggle ">screen " ;;
    toggle-menu)   exec caelestia shell launcher toggle ">toggle " ;;
    theme)         exec caelestia shell launcher toggle ">scheme " ;;
    tailscale)     exec caelestia shell launcher toggle ">tailscale " ;;
    taildrop)      exec caelestia shell launcher toggle ">taildrop " ;;
    overview)      exec caelestia shell drawers toggle overview ;;
    lock)          exec caelestia shell lock lock ;;
  esac
else
  omarchy_shell=(env OMARCHY_PATH="/usr/share/omarchy" omarchy-shell)

  case "$action" in
    notifications)      exec "${omarchy_shell[@]}" esh.notifications toggle ;;
    dashboard)          exec "${omarchy_shell[@]}" omarchy.monitor toggle ;;
    clear-notifications) exec "${omarchy_shell[@]}" notifications dismissAll ;;
    dnd)                exec "${omarchy_shell[@]}" notifications toggleDnd ;;
    wifi)               exec "${omarchy_shell[@]}" omarchy.network toggle ;;
    bluetooth)          exec "${omarchy_shell[@]}" omarchy.bluetooth toggle ;;
    audio)              exec "${omarchy_shell[@]}" omarchy.audio toggle ;;
    monitor)            exec "${omarchy_shell[@]}" shell toggle omarchy.monitor ;;
    weather)            exec "${omarchy_shell[@]}" omarchy.weather toggle ;;
    battery)            exec "${omarchy_shell[@]}" shell toggle omarchy.power ;;
    clipboard)          exec "${omarchy_shell[@]}" shell toggle esh.clipboard ;;
    wallpaper)          exec omarchy-quattro-selector background ;;
    apps)               exec "${omarchy_shell[@]}" shell toggle omarchy.menu '{"menu":"root"}' ;;
    power)              exec omarchy-menu toggle system ;;
    taskbar)   exec omarchy-toggle-bar ;;
    settings)  exec zsh -ic hyprmod ;;
    keybinds)  exec omarchy-menu show keybindings ;;
    emoji)     exec "${omarchy_shell[@]}" shell toggle omarchy.emojis ;;
    capture)   exec "${omarchy_shell[@]}" shell summon omarchy.menu '{"menu":"capture"}' ;;
    toggle-menu) exec "${omarchy_shell[@]}" shell summon omarchy.menu '{"menu":"toggle"}' ;;
    theme)     exec omarchy-quattro-selector theme ;;
    tailscale) exec "${omarchy_shell[@]}" shell toggle omarchy.tailscale ;;
    taildrop)  exec "${omarchy_shell[@]}" shell toggle taildrop ;;
    overview)  exec "${omarchy_shell[@]}" shell toggle omarchy-overview ;;
    lock)      exec omarchy-system-lock ;;
  esac
fi

printf 'Unknown desktop shell action: %s\n' "$action" >&2
exit 2
