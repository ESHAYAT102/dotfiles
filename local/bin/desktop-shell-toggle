#!/usr/bin/env bash

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
mode_file="$state_dir/desktop-shell-mode"
requested="${1:-toggle}"
if [[ -r "$mode_file" ]]; then
  current="$(<"$mode_file")"
else
  current="caelestia"
fi

case "$requested" in
  --restore) target="$current" ;;
  toggle) [[ "$current" == "caelestia" ]] && target="omarchy" || target="caelestia" ;;
  caelestia|omarchy) target="$requested" ;;
  status) printf '%s\n' "$current"; exit 0 ;;
  *) printf 'Usage: %s [toggle|caelestia|omarchy|status|--restore]\n' "${0##*/}" >&2; exit 2 ;;
esac

mkdir -p "$state_dir"
printf '%s\n' "$target" > "$mode_file"

if [[ "$target" == "caelestia" ]]; then
  caelestia scheme set -m dark >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

  systemctl --user stop omarchy-quickshell.service 2>/dev/null || true
  systemctl --user stop omarchy-quickshell.service 2>/dev/null || true

  systemctl --user mask --runtime swaync.service >/dev/null 2>&1 || true
  systemctl --user stop swaync.service 2>/dev/null || true
  pkill -x swaync 2>/dev/null || true

  # Omarchy's suspend monitor always invokes its own locker. Hypridle routes
  # lock and pre-suspend events through desktop-shell-action instead, so keep
  # the Omarchy monitor out of the way while Caelestia owns the session.
  systemctl --user mask --runtime omarchy-sleep-lock.service >/dev/null 2>&1 || true
  systemctl --user stop omarchy-sleep-lock.service 2>/dev/null || true

  if ! pgrep -f '^qs -c caelestia( |$)' >/dev/null; then
    env -u QT_SCALE_FACTOR caelestia shell -d
  fi
  systemctl --user start caelestia-cliphist-text.service caelestia-cliphist-image.service
else
  caelestia shell -k 2>/dev/null || true
  systemctl --user stop caelestia-cliphist-text.service caelestia-cliphist-image.service 2>/dev/null || true
  systemctl --user unmask --runtime swaync.service >/dev/null 2>&1 || true
  systemctl --user start swaync.service 2>/dev/null || true
  systemctl --user unmask --runtime omarchy-sleep-lock.service >/dev/null 2>&1 || true
  systemctl --user start omarchy-sleep-lock.service
  systemctl --user start omarchy-quickshell.service
fi

systemctl --user restart hypridle.service
hyprctl reload >/dev/null 2>&1 || true
"$HOME/.local/bin/desktop-shell-borders" "$target"
if [[ "$target" == "caelestia" ]]; then
  ln -sfn "$HOME/.config/ghostty/caelestia-colors.conf" "$HOME/.config/ghostty/mode-colors.conf"
else
  ln -sfn "$HOME/.local/state/omarchy/current/theme/ghostty.conf" "$HOME/.config/ghostty/mode-colors.conf"
fi
omarchy-restart-terminal >/dev/null 2>&1 || true
if [[ "$target" == "caelestia" ]]; then
  sleep 1
  caelestia shell toaster info "Desktop Shell" "Caelestia mode enabled" "desktop_windows" >/dev/null 2>&1 || true
else
  notify-send -a "Desktop Shell" "Omarchy mode enabled"
fi
