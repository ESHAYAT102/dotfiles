#!/bin/bash

# omarchy:summary=Insert an emoji into the focused application
# omarchy:group=menu
# omarchy:args=<emoji>
# omarchy:hidden=true

emoji="${1:-}"

[[ -n $emoji ]] || exit

printf '%s' "$emoji" | wl-copy --type text/plain --foreground

sleep 0.3

hyprctl eval "hl.dispatch(hl.dsp.send_key_state({mods='CTRL', key='V', state='down'}))" 2>/dev/null
sleep 0.05
hyprctl eval "hl.dispatch(hl.dsp.send_key_state({mods='CTRL', key='V', state='up'}))" 2>/dev/null
